ARG NODE_VERSION=20.15.1

################################################################################
# Use node image for base image for all stages.
FROM node:${NODE_VERSION}-alpine AS base

# Set working directory for all build stages.
WORKDIR /usr/src/app

################################################################################
# Create a stage for installing production dependecies.
FROM base AS deps

RUN --mount=type=bind,source=package.json,target=package.json \
    --mount=type=bind,source=package-lock.json,target=package-lock.json \
    --mount=type=bind,source=tsconfig.json,target=tsconfig.json \
    --mount=type=cache,target=/root/.npm \
    npm ci --omit=dev

################################################################################
# Create a stage for building the application.
FROM deps AS build

ENV APP=demo-1

# Copy the rest of the source files into the image.
COPY . .

# Run the build script.
RUN npm run build:${APP} && npm run build:libs

################################################################################
# Create a new stage to run the application with minimal runtime dependencies
# where the necessary files are copied from the build stage.
FROM base AS final

# Use production node environment by default.
ENV NODE_ENV=production
ENV APP=demo-1
ENV PORT=3000

# Ensure dist directory exists and has the right permissions
RUN mkdir -p /usr/src/app/dist && chown -R node:node /usr/src/app/dist

# Run the application as a non-root user.
USER node

# Copy the necessary files and folders from the build stage
COPY --from=deps /usr/src/app/node_modules ./node_modules
COPY --from=build /usr/src/app/dist ./dist

EXPOSE ${PORT}

# Run the application.
CMD ["sh", "-c", "npm run start:prod-${APP}"]