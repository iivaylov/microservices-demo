{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/new-demo/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/new-demo/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/new-demo",
  "projects": {
    "new-demo": {
      "type": "application",
      "root": "apps/new-demo",
      "entryFile": "main",
      "sourceRoot": "apps/new-demo/src",
      "compilerOptions": {
        "tsConfigPath": "apps/new-demo/tsconfig.app.json"
      }
    },
    "demo-1": {
      "type": "application",
      "root": "apps/demo-1",
      "entryFile": "main",
      "sourceRoot": "apps/demo-1/src",
      "compilerOptions": {
        "tsConfigPath": "apps/demo-1/tsconfig.app.json"
      }
    },
    "demo-2": {
      "type": "application",
      "root": "apps/demo-2",
      "entryFile": "main",
      "sourceRoot": "apps/demo-2/src",
      "compilerOptions": {
        "tsConfigPath": "apps/demo-2/tsconfig.app.json"
      }
    },
    "db-connection": {
      "type": "library",
      "root": "libs/db-connection",
      "entryFile": "index",
      "sourceRoot": "libs/db-connection/src",
      "compilerOptions": {
        "tsConfigPath": "libs/db-connection/tsconfig.lib.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    }
  }
}